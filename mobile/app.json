{
  "expo": {
    "name": "Bill Reminder",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ashergabrieljose.billreminder",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bill Reminder to access your photos so you can upload bills.",
          "cameraPermission": "Allow Bill Reminder to use the camera to scan bills."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Bill Reminder to add reminders to your calendar."
        }
      ]
    ]
  }
}
