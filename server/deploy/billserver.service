# systemd service so the API runs 24/7 on the Oracle VM (auto-restart, survives reboot).
# Install steps (run on the VM):
#   sudo cp ~/billserver/deploy/billserver.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now billserver
#   sudo systemctl status billserver        # check it's running
#
# The app reads its API key from ~/billserver/.env automatically (no EnvironmentFile needed).

[Unit]
Description=Bill Reminder API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/billserver
ExecStart=/home/ubuntu/billserver/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
