# Copy this file to ".env" and fill in your real key.
#   cp .env.example .env
# Then edit .env and paste your Anthropic API key.

ANTHROPIC_API_KEY=""

# Which AI model reads the bills.
#   claude-haiku-4-5   -> cheapest  (~$0.005/scan)  good for most bills
#   claude-sonnet-4-6  -> balanced  (~$0.01-0.02/scan)  <- default, recommended
#   claude-opus-4-8    -> most accurate (~$0.03-0.05/scan)
MODEL=claude-sonnet-4-6
